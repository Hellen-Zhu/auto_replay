{
  "formatVersion": 1,
  "name": "Maker logs in, lands on the Trades page and sees the current user",
  "description": "Log in to OREO with the maker account, verify the redirect to the Trades page and that the top-right user menu shows maker",
  "source": "tests/login.spec.ts › Maker logs in, lands on the Trades page and sees the current user @case:login_maker_trades",
  "codeVersion": "local",
  "exportedAt": "2026-10-08T06:14:31.670Z",
  "requiredConfig": [
    "accounts.maker.email",
    "accounts.maker.password",
    "accounts.maker.displayName"
  ],
  "steps": [
    {
      "title": "Log in as maker",
      "action": "goto",
      "value": "/"
    },
    {
      "action": "expectVisible",
      "target": {
        "testId": "login-dialog"
      }
    },
    {
      "action": "fill",
      "target": {
        "testId": "login-email-input",
        "inner": "input"
      },
      "value": "${cfg:accounts.maker.email}"
    },
    {
      "action": "fill",
      "target": {
        "testId": "login-password-input",
        "inner": "input"
      },
      "value": "${cfg:accounts.maker.password}",
      "secret": true
    },
    {
      "action": "click",
      "target": {
        "testId": "login-sign-in-to-portal-btn"
      }
    },
    {
      "title": "Verify the Trades page is shown",
      "action": "expectUrl",
      "value": "/trades"
    },
    {
      "action": "expectVisible",
      "target": {
        "testId": "layout-new-trade-btn"
      }
    },
    {
      "title": "Verify the top-right corner shows the current user",
      "action": "expectText",
      "target": {
        "testId": "layout-user-menu-btn"
      },
      "value": "${cfg:accounts.maker.displayName}"
    }
  ]
}