# ── PAGE: NEW TRADE ─────────────────────────────────────────────────

@Then "^page new trade container is visible$"
    Then assert that 'new_trade.container' is eventually visible

@When "^page new trade selects counterparty from stored variable '([^']*)'$"
    When type inner value '$1' from stored variable into 'new_trade.counterparty_select'
    And click option from stored variable '$1'

@When "^page new trade selects portfolio from stored variable '([^']*)'$"
    When type inner value '$1' from stored variable into 'new_trade.portfolio_select'
    And click option from stored variable '$1'

@When "^page new trade selects productId from stored variable '([^']*)'$"
    When type inner value '$1' from stored variable into 'new_trade.product_id_input'
    And click option from stored variable '$1'

@When "^page new trade selects direction from stored variable '([^']*)'$"
    When type inner value '$1' from stored variable into 'new_trade.direction_select'
    And click option from stored variable '$1'

@When "^page new trade selects basic mandatory info for product '([^']*)'$"
    When page new trade selects counterparty from stored variable 'basic.counterpartyName'
    And page new trade selects portfolio from stored variable 'basic.portfolioId'
    And store e2e variable value '$1' as 'productId'
    And page new trade selects productId from stored variable 'productId'
    And page new trade selects direction from stored variable 'basic.direction'

@When "^page new trade (save|book) and captures trade id as '([^']*)'$"
    When click $1 using configured risk engine mode for new trade creation
    And component trade change confirmation dialog is visible
    And confirm new trade creation and capture response as 'tradeCreateResponse'
    And store e2e response field 'data.trade.id' from stored variable 'tradeCreateResponse' as '$2'

@When "^page new trade enables stepin toggle$"
    When click 'new_trade.stepin_toggle'

@When "^page new trade selects stepin partial radio$"
    When click 'new_trade.stepin_partial_radio'

@When "^page new trade selects stepin full radio$"
    When click 'new_trade.stepin_full_radio'

@When "^page new trade selects old counterparty from stored variable '([^']*)'$"
    When type inner value '$1' from stored variable into 'new_trade.stepin_old_counterparty_select'
    And click option from stored variable '$1'
